@app.post("/login")
def login(form_data: OAuth2PasswordRequestForm = Depends(), db: Session = Depends(get_db)):
    # 1. Verify Credentials
    user = db.query(User).filter(User.email == form_data.username).first()
    
    if not user or not verify_password(form_data.password, user.hashed_password):
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Incorrect email or password",
            headers={"WWW-Authenticate": "Bearer"},
        )
        
    # 2. Create a DB Session (Stateful)
    session_id = create_session(db, user.id)
    
    # 3. Return the Session ID 
    # We use the key "access_token" so your frontend code doesn't need to change.
    return {
        "access_token": session_id, 
        "token_type": "bearer",
        "user": {
            "email": user.email,
            "name": user.name,
            "role": user.role,
        },
    }

@app.post("/logout")
def logout(
    token: str = Depends(oauth2_scheme), # --- FIX: Removed 'security.' prefix
    db: Session = Depends(get_db)
):
    # 1. Delete the session from the DB
    delete_session(db, token)
    return {"message": "Logged out successfully"}

